{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-usage-report",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  // 크론 전용 Worker — HTTP 노출 없음(workers.dev 비활성, 라우트 없음).
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // 6시간마다: 00:10·06:10·12:10·18:10 UTC = KST 09:10·15:10·21:10·03:10.
  // 리포트 본체는 결제 주기(매달 BILLING_DAY일) 누적 사용량이다. 00:10 UTC(KST 09:10) 발송분의 하루 줄은 막 끝난
  // 어제(UTC) 하루 총량이고, 나머지 발송분은 오늘(UTC)의 중간 집계다.
  "triggers": {
    "crons": ["10 0,6,12,18 * * *"]
  },
  // secrets(wrangler secret put): CF_ANALYTICS_TOKEN(Analytics·KV·D1 Read), DISCORD_WEBHOOK_URL
  "vars": {
    "ACCOUNT_ID": "492eb95b0233bc6c035d6dafd5c7a616",
    "OCW_DB_ID": "340fb3b8-5a64-4fd5-8d11-8cd316ad8178",
    // Workers Paid 구독 갱신일. 월 포함량이 이날 리셋된다(2026-11 가입, 결제일 18일).
    "BILLING_DAY": "18"
  }
}
